{
  "manifest_version": 3,
  "name": "密钥助手",
  "short_name": "密钥助手",
  "version": "0.6.0",
  "description": "在华为、小米、OPPO、vivo、荣耀、应用宝开发者后台里一键取回 API 密钥，直接保存到配置平台并在线验证。只连配置平台。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "密钥助手",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://developer.huawei.com/*",
    "https://dev.mi.com/*",
    "https://dev.xiaomi.com/*",
    "https://open.oppomobile.com/*",
    "https://dev.vivo.com.cn/*",
    "https://developer.honor.com/*",
    "https://developer.hihonor.com/*",
    "https://open.qq.com/*",
    "https://*.open.qq.com/*",
    "http://192.168.1.18:16003/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://developer.huawei.com/*",
        "https://dev.mi.com/*",
        "https://dev.xiaomi.com/*",
        "https://open.oppomobile.com/*",
        "https://dev.vivo.com.cn/*",
        "https://developer.honor.com/*",
        "https://developer.hihonor.com/*",
        "https://open.qq.com/*",
        "https://*.open.qq.com/*"
      ],
      "js": [
        "src/content/sniff-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://developer.huawei.com/*",
        "https://dev.mi.com/*",
        "https://dev.xiaomi.com/*",
        "https://open.oppomobile.com/*",
        "https://dev.vivo.com.cn/*",
        "https://developer.honor.com/*",
        "https://developer.hihonor.com/*",
        "https://open.qq.com/*",
        "https://*.open.qq.com/*"
      ],
      "js": [
        "src/recipes.js",
        "src/shared.js",
        "src/content/panel-style.js",
        "src/content/console.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://192.168.1.18:16003/*",
        "http://localhost/*"
      ],
      "js": [
        "src/content/bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
